---
import { company } from '../data/site';
const q = encodeURIComponent(company.mapsQuery);
const embed = `https://www.google.com/maps?q=${q}&z=15&output=embed`;
const external = `https://www.google.com/maps/search/?api=1&query=${q}`;
---

<div class="map" data-map data-src={embed}>
  <div class="map__placeholder" data-map-placeholder>
    <svg class="map__art" viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect width="600" height="400" fill="#e4e6e4"></rect>
      <path d="M-20 290 C 150 250 260 330 620 210" stroke="#fff" stroke-width="34" fill="none"></path>
      <path d="M-20 290 C 150 250 260 330 620 210" stroke="#cfd2cf" stroke-width="2" stroke-dasharray="18 18" fill="none"></path>
      <path d="M330 -20 L 280 420" stroke="#fff" stroke-width="22" fill="none"></path>
      <path d="M-20 90 L 620 140" stroke="#fff" stroke-width="12" fill="none"></path>
      <path d="M470 -20 L 520 420" stroke="#fff" stroke-width="10" fill="none"></path>
      <g transform="translate(305 190)">
        <path d="M0 -46c-17 0-30 13-30 30 0 22 30 50 30 50s30-28 30-50c0-17-13-30-30-30z" fill="#2a2d30"></path>
        <circle cy="-16" r="11" fill="#ffee02"></circle>
      </g>
    </svg>
    <div class="map__panel">
      <p class="map__addr">
        <strong>{company.name}</strong><br />
        {company.street}, {company.zip} {company.city}
      </p>
      <p class="map__note">
        Beim Laden der Karte werden Daten an Google übertragen. Mehr dazu in der <a href="/datenschutzerklaerung/#google-maps"
          >Datenschutzerklärung</a
        >.
      </p>
      <div class="map__actions">
        <button class="btn btn--dark" type="button" data-map-load>Karte laden</button>
        <a class="btn btn--ghost" href={external} target="_blank" rel="noopener">Route in Google Maps</a>
      </div>
      <label class="map__remember">
        <input type="checkbox" data-map-remember />
        Karten künftig automatisch laden
      </label>
    </div>
  </div>
</div>

<script>
  const KEY = 'monsipan-maps-consent';
  const read = () => {
    try {
      return localStorage.getItem(KEY) === '1';
    } catch {
      return false;
    }
  };
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((root) => {
    const load = () => {
      const iframe = document.createElement('iframe');
      iframe.src = root.dataset.src!;
      iframe.title = 'Standort von Monsipan auf Google Maps';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      root.replaceChildren(iframe);
      root.classList.add('is-loaded');
    };
    if (read()) return load();
    root.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const remember = root.querySelector<HTMLInputElement>('[data-map-remember]');
      if (remember?.checked) {
        try {
          localStorage.setItem(KEY, '1');
        } catch {
          /* Speicher nicht verfügbar – Karte trotzdem laden */
        }
      }
      load();
    });
  });
</script>

<style>
  .map {
    position: relative;
    min-height: 26rem;
    height: 100%;
    background: var(--concrete);
    overflow: hidden;
  }

  .map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    align-items: end;
  }

  .map__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .map__panel {
    position: relative;
    margin: 1rem;
    padding: 1.25rem 1.4rem;
    background: var(--white);
    box-shadow: 0 10px 30px -12px rgba(30, 34, 36, 0.35);
    font-size: var(--step--1);
    max-width: 30rem;
  }

  .map__addr {
    font-size: var(--step-0);
  }

  .map__note {
    color: var(--grey);
  }

  .map__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-bottom: 0.75rem;
  }

  .map__actions .btn {
    font-size: var(--step--1);
  }

  .map__remember {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    color: var(--grey);
    cursor: pointer;
  }

  .map__remember input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--asphalt);
  }
</style>
