---
import ContactForm from './ContactForm.astro';
import MapConsent from './MapConsent.astro';
import { company } from '../data/site';

interface Props {
  heading?: string;
  intro?: string;
  as?: 'h1' | 'h2';
}
const {
  heading = 'Sprechen wir über Ihr Projekt.',
  intro = 'Beschreiben Sie kurz, was markiert oder beschichtet werden soll – wir melden uns mit einem Angebot oder einem Terminvorschlag für eine Besichtigung.',
  as: H = 'h2',
} = Astro.props;
---

<section class="contact section" id="anfrage" aria-labelledby="contact-h">
  <div class="wrap contact__grid">
    <div class="contact__main">
      <H id="contact-h" class="display h2">{heading}</H>
      <p class="lead contact__intro">{intro}</p>
      <ContactForm />
    </div>

    <aside class="contact__side">
      <dl class="facts">
        <div>
          <dt>Telefon</dt>
          <dd><a href={company.phoneHref}>{company.phone}</a></dd>
        </div>
        <div>
          <dt>E-Mail</dt>
          <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
        </div>
        <div>
          <dt>Adresse</dt>
          <dd>{company.street}<br />{company.zip} {company.city}</dd>
        </div>
        <div>
          <dt>Bürozeiten</dt>
          <dd>{company.hours}</dd>
        </div>
      </dl>
      <MapConsent />
    </aside>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .contact__intro {
    margin: 1.5rem 0 2.5rem;
  }

  .contact__side {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }

  dt {
    font-size: var(--step--1);
    color: var(--grey);
    margin-bottom: 0.2rem;
  }

  dd {
    margin: 0;
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  dd a {
    text-decoration: none;
  }

  dd a:hover {
    text-decoration: underline;
  }

  .contact__side :global(.map) {
    flex: 1;
  }

  @media (max-width: 60rem) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 26rem) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
