---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroRoad from '../components/HeroRoad.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import ContactSection from '../components/ContactSection.astro';
import { company, equipment } from '../data/site';
import { auftraggeber } from '../data/referenzen';
import { projektImage } from '../lib/images';
import lkw from '../assets/misc/monsipan_lkw2-scaled.webp';

const strip = [
  { img: projektImage('flaechenmarkierung', 'flaeche_24.webp'), alt: 'Bunt markierter Schutzweg in Regenbogenfarben' },
  { img: projektImage('laengsmarkierung', 'laengs_3.webp'), alt: 'Markiermaschine zieht eine Randlinie auf einer Landstraße' },
  { img: projektImage('sonderprojekte', 'sonder_28.webp'), alt: 'Spielerische Bodenmarkierung mit Kreisen und Wellenlinien auf einem Gehweg' },
  { img: projektImage('blindenleitsystem', 'blindenleitsystem_3.webp'), alt: 'Taktiles Leitsystem mit roten Aufmerksamkeitsfeldern auf einem Vorplatz' },
  { img: projektImage('flaechenmarkierung', 'flaeche_36.webp'), alt: 'Rot markierte Fahrbahnteiler bei einer Autobahnabfahrt' },
  { img: projektImage('beschichtungen', 'beschichtung_4.webp'), alt: 'Grün beschichtete E-Ladeplätze in einer Tiefgarage' },
  { img: projektImage('sonderprojekte', 'sonder_33.webp'), alt: 'Hüpfspiel in Gelb auf dunklem Asphalt' },
];

const years = new Date().getFullYear() - company.founded;
---

<Base>
  <section class="hero">
    <div class="wrap hero__inner">
      <h1 class="display hero__title">
        <span class="line"><span>Jeder Zentimeter</span></span>
        <span class="line"><span>zählt.</span></span>
      </h1>
      <div class="hero__aside">
        <p class="hero__lead">
          Bodenmarkierungen und Beschichtungen für Autobahnen, Städte, Gemeinden und private Flächen – geplant und ausgeführt
          von Monsipan aus Schwechat, seit {company.founded}.
        </p>
        <div class="hero__cta">
          <a class="btn" href="/kontakt/#anfrage">Anfrage senden</a>
          <a class="btn btn--ghost" href="/projekte/">Projekte ansehen</a>
        </div>
      </div>
    </div>
    <HeroRoad />
  </section>

  <section class="section intro" aria-labelledby="intro-h">
    <div class="wrap intro__grid">
      <div class="intro__text">
        <h2 id="intro-h" class="display h2">Mit der richtigen Markierung läuft es einfach besser.</h2>
        <p class="lead">
          Wir sind Ihr Spezialist für Bodenmarkierungen – von der Beratung bis zur fertigen Linie. Für öffentliche
          Auftraggeber arbeiten wir exakt nach den geforderten Richtlinien, für private Kunden ganz nach Wunsch und
          Anforderung.
        </p>
        <p class="muted">
          Seit {years} Jahren setzen Stadtgemeinden, Länder, die ASFINAG und Unternehmen auf unser Team, unseren modernen
          Maschinenpark und hochwertige Materialien.
        </p>
      </div>
      <figure class="intro__photo">
        <Picture
          src={lkw}
          formats={['avif']} fallbackFormat="webp"
          widths={[600, 900, 1300]} width={1300}
          sizes="(min-width: 60rem) 45vw, 100vw"
          alt="Gelber LKW-Zug mit Monsipan-Beschriftung"
          loading="lazy"
        />
      </figure>
    </div>

    <div class="wrap">
      <div class="fleet">
        <h3 class="fleet__h">Unsere Ausstattung</h3>
        <dl class="fleet__list">
          {
            equipment.map((e) => (
              <div class="fleet__item">
                <dt>{e.label}</dt>
                <dd data-count={e.value}>{e.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="fleet__more muted">
          Dazu mehrere handgeführte Airless-Spritzgeräte und Folienverlegegeräte – und Turbinentrockner, damit wir auch nach
          Regen markieren können.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--concrete" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="svc-h" class="display h2">Was wir markieren</h2>
        <p class="muted">Sieben Leistungsbereiche, ein Ansprechpartner. Wählen Sie einen Bereich für Details und Bilder.</p>
      </div>
      <ServiceIndex />
    </div>
  </section>

  <section class="strip" aria-label="Eindrücke aus unseren Projekten">
    <ul class="strip__track" role="list">
      {
        strip.map((s) => (
          <li>
            <Picture src={s.img} formats={['avif']} fallbackFormat="webp" widths={[420, 720]} width={720} sizes="(min-width: 60rem) 26vw, 70vw" alt={s.alt} loading="lazy" />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section refs" aria-labelledby="refs-h">
    <div class="wrap refs__grid">
      <div>
        <h2 id="refs-h" class="display h2">Auftraggeber, die auf uns zählen</h2>
        <p class="lead refs__lead">
          Mehrjährige Rahmenverträge in Wien, Niederösterreich und der Steiermark – und viele Gemeinden, Betriebe und
          Private.
        </p>
        <a class="btn btn--dark" href="/referenzen/">Alle Referenzen</a>
      </div>
      <ul class="refs__names" role="list">
        {auftraggeber.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  <section class="career" aria-labelledby="career-h">
    <div class="wrap career__inner">
      <h2 id="career-h" class="display h2">Werden Sie Teil unseres Teams.</h2>
      <div>
        <p class="lead">
          Das Wir ist uns wichtig – zusammen, gemeinsam, im Team. Wenn Sie mit uns für mehr Sicherheit auf den Straßen
          sorgen möchten, freuen wir uns auf Ihre Bewerbung.
        </p>
        <div class="career__cta">
          <a class="btn btn--dark" href={`mailto:${company.email}?subject=Bewerbung`}>Bewerbung senden</a>
          <a class="btn btn--ghost" href={company.phoneHref}>Anrufen: {company.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
</Base>

<style>
  /* HERO */
  .hero {
    padding-top: clamp(2.5rem, 7vw, 6.5rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2.25rem 4rem;
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .hero__title {
    grid-column: 1 / -1;
    font-size: var(--step-5);
  }

  .hero__aside {
    display: contents;
  }

  .hero__lead {
    max-width: 34em;
    margin: 0;
  }

  .hero__title .line {
    display: block;
    overflow: hidden;
    padding: 0.04em 0.1em 0.1em 0;
    margin-bottom: -0.1em;
  }

  .hero__title .line > span {
    display: inline-block;
  }

  .hero__lead {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title .line > span {
      animation: hero-rise 1.1s var(--ease-out) both;
    }

    .hero__title .line:nth-child(2) > span {
      animation-delay: 0.12s;
    }

    .hero__lead,
    .hero__cta {
      animation: hero-fade 1s var(--ease-out) 0.35s both;
    }

    .hero__cta {
      animation-delay: 0.45s;
    }
  }

  @keyframes hero-rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  @media (max-width: 60rem) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
  }

  /* INTRO */
  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .intro__text .lead {
    margin-top: 1.75rem;
  }

  .intro__photo {
    margin: 0;
    clip-path: polygon(6% 0, 100% 0, 94% 100%, 0 100%);
  }

  .intro__photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .fleet {
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .fleet__h {
    font-size: var(--step-1);
    margin-bottom: 1.25rem;
  }

  .fleet__list {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    margin: 0;
    border-top: 2px solid var(--ink);
  }

  .fleet__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 1.1rem 1rem 0 0;
    border-right: 1px solid var(--line);
  }

  .fleet__item + .fleet__item {
    padding-left: 1rem;
  }

  .fleet__item:last-child {
    border-right: 0;
  }

  .fleet__item dd {
    margin: 0;
    font-size: var(--step-4);
    font-weight: 850;
    font-style: italic;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .fleet__item dt {
    margin-top: 0.4rem;
    color: var(--grey);
    font-weight: 600;
  }

  .fleet__more {
    margin-top: 1.75rem;
    max-width: 44em;
  }

  @media (max-width: 60rem) {
    .intro__grid {
      grid-template-columns: 1fr;
    }

    .fleet__list {
      grid-template-columns: repeat(3, 1fr);
    }

    .fleet__item {
      padding: 1.1rem 1rem 1.1rem 0;
      border-bottom: 1px solid var(--line);
    }

    .fleet__item + .fleet__item {
      padding-left: 0;
    }

    .fleet__item:nth-child(3n) {
      border-right: 0;
    }

    .fleet__item:not(:nth-child(3n + 1)) {
      padding-left: 1rem;
    }
  }

  @media (max-width: 30rem) {
    .fleet__list {
      grid-template-columns: repeat(2, 1fr);
    }

    .fleet__item:nth-child(3n) {
      border-right: 1px solid var(--line);
    }

    .fleet__item:nth-child(2n) {
      border-right: 0;
    }

    .fleet__item:not(:nth-child(3n + 1)) {
      padding-left: 0;
    }

    .fleet__item:nth-child(2n) {
      padding-left: 1rem;
    }
  }

  /* SECTION HEAD */
  .sec-head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 1rem clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .sec-head p {
    margin: 0;
    max-width: 30em;
  }

  @media (max-width: 64rem) {
    .sec-head {
      grid-template-columns: 1fr;
    }
  }

  /* STRIP */
  .strip {
    padding-block: clamp(3rem, 6vw, 5rem) 0;
    overflow: hidden;
  }

  .strip__track {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .strip__track::-webkit-scrollbar {
    display: none;
  }

  .strip__track li {
    flex: 0 0 clamp(15rem, 26vw, 24rem);
    scroll-snap-align: start;
  }

  .strip__track li:nth-child(even) {
    margin-top: clamp(1.5rem, 4vw, 3.5rem);
  }

  .strip__track :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  /* bei Scroll gleitet der Streifen seitlich – nur wo unterstützt */
  @media (prefers-reduced-motion: no-preference) and (min-width: 60rem) {
    @supports (animation-timeline: view()) {
      .strip__track {
        overflow: visible;
        animation: strip-slide linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }

  @keyframes strip-slide {
    from {
      transform: translateX(6%);
    }
    to {
      transform: translateX(-22%);
    }
  }

  /* REFERENZEN */
  .refs__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .refs__lead {
    margin: 1.5rem 0 2rem;
  }

  .refs__names {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .refs__names li {
    padding: 1rem 0 0.8rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-2);
    font-weight: 750;
    letter-spacing: -0.01em;
  }

  @media (max-width: 60rem) {
    .refs__grid {
      grid-template-columns: 1fr;
    }
  }

  /* KARRIERE – gelbe Fläche mit Sperrflächen-Schraffur */
  .career {
    position: relative;
    background: var(--signal);
    padding-block: clamp(4rem, 9vw, 8rem);
    overflow: hidden;
  }

  .career::before,
  .career::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 14px;
    background: repeating-linear-gradient(-55deg, var(--asphalt) 0 14px, transparent 14px 32px);
  }

  .career::before {
    top: 0;
  }

  .career::after {
    bottom: 0;
  }

  .career__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    align-items: end;
  }

  .career__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.75rem;
  }

  .career .btn--ghost:hover {
    text-decoration-color: var(--ink);
  }

  @media (max-width: 60rem) {
    .career__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
