---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { leistungen } from '../../data/leistungen';
import { projektImage, galleryOf } from '../../lib/images';
import cover from '../../assets/projekte/flaechenmarkierung/flaeche_10.webp';
---

<Base
  title="Projekte & Leistungen"
  description="Längs- und Flächenmarkierung, taktile Leitsysteme, Baustellenmarkierung, Demarkierung, Sonderprojekte und Beschichtungen – Leistungen und Projektbilder von Monsipan."
  image={cover}
>
  <PageHeader
    title="Projekte & Leistungen"
    lead="Ob öffentliche Straße oder privates Gelände: Wir setzen Linien, Flächen, Schriften, Symbole und Beschichtungen in jeder Größe und Farbe um – mit handgeführten Maschinen für den Parkplatz ebenso wie mit Großgeräten für die Autobahn."
  />

  <section class="section">
    <ul class="wrap plist" role="list">
      {
        leistungen.map((l, i) => (
          <li class:list={['pitem', { 'pitem--flip': i % 2 === 1 }]}>
            <a href={`/projekte/${l.slug}/`} class="pitem__link">
              <span class="pitem__media">
                <Picture
                  src={projektImage(l.folder, l.cover)}
                  formats={['avif']} fallbackFormat="webp"
                  widths={[480, 800, 1100]} width={1100}
                  sizes="(min-width: 60rem) 50vw, 100vw"
                  alt=""
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              </span>
              <span class="pitem__body">
                <span class="pitem__title display" set:html={l.titleHyphen} />
                <span class="pitem__text">{l.short}</span>
                <span class="pitem__meta">
                  {galleryOf(l.folder).length} Projektbilder ansehen
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .plist {
    list-style: none;
    margin-block: 0;
    display: grid;
    gap: clamp(3rem, 7vw, 6.5rem);
  }

  .pitem__link {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: center;
    text-decoration: none;
  }

  .pitem--flip .pitem__media {
    order: 2;
  }

  .pitem__media {
    display: block;
    overflow: hidden;
    clip-path: polygon(5% 0, 100% 0, 95% 100%, 0 100%);
    background: var(--concrete);
  }

  .pitem__media :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .pitem__link:hover .pitem__media :global(img) {
    transform: scale(1.05);
  }

  .pitem__body {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .pitem__title {
    font-size: var(--step-3);
  }

  .pitem__text {
    font-size: var(--step-1);
    color: var(--grey);
    max-width: 26em;
  }

  .pitem__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding-bottom: 0.25rem;
    font-weight: 750;
    border-bottom: 4px solid var(--signal);
  }

  .pitem__meta svg {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.4s var(--ease-out);
  }

  .pitem__link:hover .pitem__meta svg {
    transform: translateX(0.3rem);
  }

  @media (max-width: 52rem) {
    .pitem__link {
      grid-template-columns: 1fr;
    }

    .pitem--flip .pitem__media {
      order: 0;
    }
  }
</style>
